# Environment variables for DreamScape Backend

# Server
PORT=5000
NODE_ENV=development
FEATURE_ORACLE_ENABLED=false
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_API_KEY=
OLLAMA_FALLBACK_MODEL=qwen3.5:9b
DREAM_OLLAMA_ANALYSIS_MODEL=qwen3.5:9b
DREAM_OLLAMA_REPAIR_MODEL=qwen3.5:9b
ORACLE_OLLAMA_CHAT_MODEL=qwen3.5:9b
ORACLE_OLLAMA_ANALYSIS_MODEL=qwen3.5:9b
RULE_V3_OLLAMA_MODEL=qwen3.5:9b

# MongoDB
MONGODB_URI=mongodb://localhost:27017/dreamscape
# Domain targets use the same MongoDB cluster. Routing remains disabled until
# backup, copy, and checksum verification have all completed.
MONGODB_CORE_DB=dreamscape_core
MONGODB_KNOWLEDGE_DB=dreamscape_knowledge
MONGODB_OPERATIONS_DB=dreamscape_operations
MONGODB_DOMAIN_ROUTING_ENABLED=false

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Dedicated HMAC secret for purpose/session-bound OTP and recovery grants.
# Required in production; use at least 32 random characters.
OTP_HMAC_SECRET=

# Server-side encryption at rest for message bodies and conversation previews.
# Generate independent 32-byte random keys, base64 encode them, and retain old
# versions during rotation so existing ciphertext remains decryptable.
MESSAGE_ENCRYPTION_ACTIVE_VERSION=v1
MESSAGE_ENCRYPTION_KEYS=
# Separate HMAC keyring for exact blind n-gram search tokens. Never reuse the
# encryption key and retain old search versions until reindexing is complete.
MESSAGE_SEARCH_ACTIVE_VERSION=s1
MESSAGE_SEARCH_KEYS=

# CORS
CORS_ORIGIN=http://localhost:5173

# SMTP (required by registration, email-change, and password-recovery OTP flows)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Original PDFs use Firebase Storage. Cloudinary remains responsible for figures/images.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Preferred on hosted environments such as Render: base64 of the complete
# Firebase service-account JSON. Keep it server-side and never expose it to Vite.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_STORAGE_BUCKET=
ORIGINAL_PDF_STORAGE_PROVIDER=firebase
# Oracle model routing. Local Ollama remains the safe default.
ORACLE_MODEL_PROVIDER=ollama
ORACLE_CONTEXT_WINDOW=32768
# Dedicated secret used to AES-256-GCM encrypt per-user model credentials.
# Use at least 32 random characters. Never reuse JWT_SECRET or another service key.
ORACLE_CREDENTIAL_ENCRYPTION_KEY=
# Optional OpenAI-compatible provider. Enabling it may send authorized private
# Oracle context to that provider; keep disabled until the product privacy
# notice/consent flow is approved.
# ORACLE_MODEL_PROVIDER=openai_compatible
# ORACLE_EXTERNAL_API_BASE_URL=https://api.openai.com/v1
# ORACLE_EXTERNAL_API_KEY=
# ORACLE_EXTERNAL_MODEL=
# ORACLE_EXTERNAL_PRIVATE_CONTEXT_ACKNOWLEDGED=false

# Redis-backed queues and rate limiting
REDIS_URL=
REDIS_KEY_PREFIX=dreamscape:
REDIS_REQUIRED=false

# HTTP security. CORS_ORIGIN accepts a comma-separated exact-origin allowlist.
TRUST_PROXY=
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=256kb
ENABLE_API_DOCS=false
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GLOBAL_WINDOW_MS=300000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_OTP_MAX=15
RATE_LIMIT_OTP_WINDOW_MS=900000
RATE_LIMIT_RECOVERY_MAX=10
RATE_LIMIT_RECOVERY_WINDOW_MS=1800000
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW_MS=1800000
RATE_LIMIT_ORACLE_MAX=60
RATE_LIMIT_ORACLE_WINDOW_MS=1800000
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
